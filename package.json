{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "astro dev --port 8080",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.5",
    "better-sqlite3": "^13.0.3",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
