---
import { marked } from "marked";
import Doc from "../../../components/Doc.astro";

// README.md links the decision records by repo-relative path, which from
// /readme/ resolves here, so the same link works on GitHub and on the app.
const records = import.meta.glob<string>("../../../../decisions/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});
const source = Object.entries(records).find(([path]) => path.endsWith(`/${Astro.params.file}`))?.[1];
if (source === undefined) return new Response("no such decision record", { status: 404 });

const title = source.match(/^# (.*)$/m)?.[1] ?? "Decision record";
const html = marked.parse(source, { async: false }) as string;
---

<Doc title={title} description={`Decision record: ${title}.`} html={html} />
