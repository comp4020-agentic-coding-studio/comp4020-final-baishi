---
import { marked } from "marked";
import readmeSource from "../../README.md?raw";
import "../styles/global.css";

const body = marked.parse(readmeSource, { async: false }) as string;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About &mdash; The Scroll</title>
  </head>
  <body>
    <header>
      <p class="tagline"><a href="/">&larr; back to the scroll</a></p>
    </header>
    <main class="readme" set:html={body} />
  </body>
</html>

<style>
  .readme {
    line-height: 1.6;
  }
  .readme :global(h1) {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .readme :global(a) {
    color: var(--accent);
  }
  .readme :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    opacity: 0.85;
  }
</style>
